<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title>rag-score report — {{ run.run_id }}</title>
<style>
  :root {
    --bg: #0f1117; --panel: #171a23; --border: #262a36;
    --text: #e6e8ee; --muted: #8b90a0;
    --good: #3ecf8e; --mid: #e8b339; --bad: #f0546b;
    --accent: #7c9dff;
  }
  * { box-sizing: border-box; }
  body {
    background: var(--bg); color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    margin: 0; padding: 40px 24px;
  }
  .wrap { max-width: 980px; margin: 0 auto; }
  h1 { font-size: 22px; margin: 0 0 4px; }
  .meta { color: var(--muted); font-size: 13px; margin-bottom: 32px; }
  .cards {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px; margin-bottom: 32px;
  }
  .card {
    background: var(--panel); border: 1px solid var(--border);
    border-radius: 10px; padding: 16px;
  }
  .card .label { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
  .card .value { font-size: 28px; font-weight: 600; margin-top: 6px; }
  .score-good { color: var(--good); }
  .score-mid { color: var(--mid); }
  .score-bad { color: var(--bad); }
  h2 { font-size: 16px; margin: 32px 0 12px; color: var(--text); }
  table { width: 100%; border-collapse: collapse; background: var(--panel); border-radius: 10px; overflow: hidden; }
  th, td { text-align: left; padding: 10px 14px; border-bottom: 1px solid var(--border); font-size: 13px; }
  th { color: var(--muted); font-weight: 500; text-transform: uppercase; font-size: 11px; letter-spacing: .04em; }
  tr:last-child td { border-bottom: none; }
  .q-text { max-width: 320px; }
  .answer-text { color: var(--muted); max-width: 320px; }
  .badge { display: inline-block; padding: 2px 8px; border-radius: 6px; font-size: 12px; font-weight: 600; }
  .badge-error { background: rgba(240,84,107,0.15); color: var(--bad); }
  .metric-pill { display: inline-block; padding: 2px 7px; border-radius: 6px; font-size: 12px; margin: 2px 3px 2px 0; }
  footer { margin-top: 40px; color: var(--muted); font-size: 12px; text-align: center; }
</style>
</head>
<body>
<div class="wrap">
  <h1>rag-score evaluation report</h1>
  <div class="meta">
    run <strong>{{ run.run_id }}</strong> &middot; project {{ run.project_name }} &middot;
    dataset {{ run.dataset_name }} &middot; {{ run.run_timestamp }}
  </div>

  <div class="cards">
    <div class="card">
      <div class="label">Test cases</div>
      <div class="value">{{ num_results }}</div>
    </div>
    <div class="card">
      <div class="label">Errors</div>
      <div class="value {{ 'score-bad' if num_errors else 'score-good' }}">{{ num_errors }}</div>
    </div>
    {% for name, value in summary.items() %}
    <div class="card">
      <div class="label">{{ name }}</div>
      <div class="value {{ score_class(value) }}">{{ "%.3f"|format(value) }}</div>
    </div>
    {% endfor %}
    {% if telemetry_summary %}
    <div class="card">
      <div class="label">Total tokens</div>
      <div class="value">{{ telemetry_summary.total_tokens }}</div>
    </div>
    <div class="card">
      <div class="label">Est. cost</div>
      <div class="value">{{ telemetry_summary.total_cost }}</div>
    </div>
    {% endif %}
  </div>

  {% if chart_svg %}
  <h2>Average score by metric</h2>
  <div class="card" style="overflow-x: auto;">
    {{ chart_svg | safe }}
  </div>
  {% endif %}

  <h2>Per-question breakdown</h2>
  <table>
    <thead>
      <tr>
        <th>Question</th>
        <th>Answer</th>
        <th>Scores</th>
        <th>Latency</th>
        {% if telemetry_summary %}<th>Tokens / Cost</th>{% endif %}
      </tr>
    </thead>
    <tbody>
      {% for row in rows %}
      <tr>
        <td class="q-text">{{ row.question }}</td>
        <td class="answer-text">
          {% if row.error %}
            <span class="badge badge-error">error</span> {{ row.error }}
          {% else %}
            {{ row.generated_answer }}
          {% endif %}
        </td>
        <td>
          {% for name, value in row.scores.items() %}
          <span class="metric-pill {{ score_class(value) }}" style="background: rgba(255,255,255,0.06);"
                {% if name in row.reasoning %}title="{{ row.reasoning[name] }}"{% endif %}>
            {{ name }}: {{ "%.2f"|format(value) }}
          </span>
          {% endfor %}
        </td>
        <td>{{ row.total_latency_ms }}</td>
        {% if telemetry_summary %}<td>{{ row.telemetry or "—" }}</td>{% endif %}
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <footer>Generated by rag-score</footer>
</div>
</body>
</html>
